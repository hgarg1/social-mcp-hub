# OAuth 2.0 app credentials from https://console.x.com/ (not your X password).
X_CLIENT_ID=
# Only confidential clients need a client secret.
X_CLIENT_SECRET=
# Register this exact URI in your X app's authentication settings.
X_REDIRECT_URI=http://127.0.0.1:8765/callback

# Alternative to the login helper: supply an OAuth 2 USER token.
# An app-only bearer token will not work for account management.
# If set, this takes precedence over the token file and cannot auto-refresh.
X_USER_ACCESS_TOKEN=

# Optional account pin: writes fail if /users/me returns another account.
X_EXPECTED_USER_ID=
# Relative paths resolve from this project, not the MCP host's working directory.
X_TOKEN_FILE=.tokens.json
# Optional durable OAuth 2 store (takes precedence over local tokens/env access token).
X_TOKEN_DATABASE_URL=
X_TOKEN_ENCRYPTION_KEY=

# Profile edits use legacy v1.1 endpoints and require OAuth 1.0a user credentials.
# If your app still has access, generate a Read and Write access token for it.
# With all four set and no OAuth 2 token/login, these also authenticate v2 tools.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_OAUTH1_ACCESS_TOKEN=
X_OAUTH1_ACCESS_TOKEN_SECRET=

# Required only for --transport http. These are MCP client-login settings,
# separate from the X account credentials above. See DEPLOYMENT.md.
X_MCP_PUBLIC_URL=
X_MCP_AUTH_ISSUER=
X_MCP_AUTH_JWKS_URL=
X_MCP_AUTH_AUDIENCE=
X_MCP_OWNER_SUBJECT=
X_MCP_AUTH_SCOPE=openid
# Optional additional exact browser origins, comma-separated (no wildcard).
X_MCP_ALLOWED_ORIGINS=

# Optional Instagram Login (Creator/Business only).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8766/callback
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_EXPECTED_USER_ID=
INSTAGRAM_TOKEN_FILE=.instagram.tokens.json
# Empty overrides reuse X_TOKEN_DATABASE_URL / X_TOKEN_ENCRYPTION_KEY.
INSTAGRAM_TOKEN_DATABASE_URL=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
